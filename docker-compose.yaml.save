# ============================================
# Habit Tracker API - Docker Compose
# (version complète avec monitoring Prometheus)
# ============================================

services:
  api:
    build:
      context: ./api
      dockerfile: Dockerfile
    container_name: habit_tracker_api
    depends_on:
      db:
        condition: service_healthy
        required: true
    environment:
      DB_HOST: db
      DB_NAME: habits_db
      DB_PASSWORD: SecurePassword123!
      DB_PORT: "5432"
      DB_USER: admin
      PORT: "3000"
    networks:
      - habit_network
    ports:
      - "3000:3000"
    restart: unless-stopped

  db:
    container_name: habit_tracker_db
    environment:
      POSTGRES_DB: habits_db
      POSTGRES_PASSWORD: SecurePassword123!
      POSTGRES_USER: admin
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U admin -d habits_db
      timeout: 5s
      interval: 10s
      retries: 5
    image: postgres:16-alpine
    networks:
      - habit_network
    restart: unless-stopped
    volumes:
      - postgres_data:/var/lib/postgresql/data

  adminer:
    container_name: habit_tracker_adminer
    depends_on:
      db:
        condition: service_started
        required: true
    image: adminer:latest
    networks:
      - habit_network
    ports:
      - "8080:8080"
    restart: unless-stopped

  # ============================================
  # Monitoring (Prometheus + cAdvisor + Grafana)
  # ============================================

  prometheus:
    image: prom/prometheus:latest
    container_name: habit_tracker_prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    ports:
      - "9091x:9090"
    networks:
      - habit_network
    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: habit_tracker_cadvisor
    privileged: true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    ports:
      - "8082:8080"   # 8080 déjà pris par Adminer
    networks:
      - habit_network
    restart: unless-stopped

  node-exporter:
    image: prom/node-exporter:latest
    container_name: habit_tracker_node_exporter
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--path.rootfs=/rootfs'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    ports:
      - "9100:9100"
    networks:
      - habit_network
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    container_name: habit_tracker_grafana
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin
    volumes:
      - grafana_data:/var/lib/grafana
    ports:
      - "3001:3000"   # 3000 déjà pris par l'API
    networks:
      - habit_network
    restart: unless-stopped

networks:
  habit_network:
    name: habit-tracker-api_habit_network
    driver: bridge

volumes:
  postgres_data:
    name: habit-tracker-api_postgres_data
    driver: local
  prometheus_data:
  grafana_data:
